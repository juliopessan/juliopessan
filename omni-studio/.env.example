# Chave da Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# gemini | mock | auto  (auto = gemini se houver chave, senao mock)
OMNI_PROVIDER=auto

# Modelo de video
OMNI_MODEL=gemini-omni-1.1-flash

# Onde ficam banco e midias (relativo a omni-studio/)
OMNI_STORAGE_DIR=storage

OMNI_HOST=127.0.0.1
OMNI_PORT=8000
