# WhatsApp Business API (Meta Cloud API)
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Admin Panel
ADMIN_PASSWORD=troque_esta_senha_aqui
SECRET_KEY=chave_secreta_para_sessoes_aqui

# Server
PORT=8000
HOST=0.0.0.0

# --- Publicação de status no Órbita OS (opcional) ---
# Conta de serviço do Google com acesso de Editor ao arquivo do Drive.
# Sem estas variáveis o publicador fica desligado e o bot roda normalmente.
GOOGLE_SERVICE_ACCOUNT_FILE=
ORBITA_DRIVE_FILE_ID=
ORBITA_PUBLISH_SECONDS=120
